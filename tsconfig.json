{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "downlevelIteration": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "app/BadmintonQueueUI.tsx",
    "app/components/CourtControlPanel.tsx",
    "app/components/CourtZone.tsx",
    "app/components/DataManagement.tsx",
    "app/components/DroppableZone.tsx",
    "app/components/MobileFooter.tsx",
    "app/components/PDDTestComponent.tsx",
    "app/components/PlayerCard.tsx",
    "app/components/PlayerListZone.tsx",
    "app/components/QueueZone.tsx",
    "app/components/input",
    "app/components/types",
    "app/lib/utils/dragDropMonitor.ts",
    "app/lib/utils/getTimeAgo.ts",
    "app/lib/utils/localStorage.ts",
    "app/lib/utils/matchHistoryUtils.ts",
    "app/lib/utils/parsePlayerList.ts",
    "app/theme.d.ts",
    "app/theme.ts",
    "src",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
